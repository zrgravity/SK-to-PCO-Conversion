{
  "name": "sk-to-pco",
  "version": "0.1.0",
  "private": true,
  "description": "Servant Keeper to Planning Center Online sync tool via Cloudflare Workers",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate:local": "wrangler d1 execute sk-pco-db --local --file=src/db/schema.sql",
    "db:migrate:remote": "wrangler d1 execute sk-pco-db --file=src/db/schema.sql",
    "db:studio:local": "wrangler d1 studio sk-pco-db --local",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^3.109.0"
  }
}
